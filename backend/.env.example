# =============================================================================
# APLICACIÓN
# =============================================================================
PORT=3000

# =============================================================================
# BASE DE DATOS (MySQL — dbd_soporte_carteras_propias)
# =============================================================================
# Sin Docker (`docker compose up -d mysql`): DB_HOST=localhost, DB_PORT=3307
# (puerto expuesto al host). Con Docker completo, docker-compose.yml fuerza
# DB_HOST=mysql y DB_PORT=3306 (red interna) sin importar estas dos líneas.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=''
DB_POOL_SIZE=10
DB_NAME=dbd_soporte_carteras_propias

# =============================================================================
# REDIS (sesión activa por usuario y colas)
# =============================================================================
# Sin Docker (`docker compose up -d redis`): REDIS_HOST=localhost, REDIS_PORT=6380
# (el 6379 del host ya lo usa un redis nativo del equipo). Con Docker completo,
# docker-compose.yml fuerza REDIS_HOST=redis, REDIS_PORT=6379 (red interna).
REDIS_HOST=localhost
REDIS_PORT=6380

# =============================================================================
# AUTENTICACIÓN (JWT)
# =============================================================================
# Secrets distintos para access y refresh, así uno filtrado no sirve para el
# otro. Genera los tuyos por ambiente (ej. `openssl rand -hex 48`), nunca
# reutilices los de otro ambiente.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Refresh acotado a la jornada laboral (~9h, 8am-6pm): una sesión filtrada
# queda inválida el mismo día, no hasta por una semana.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=12h

# =============================================================================
# LÍMITE DE INTENTOS (login y recuperar contraseña)
# =============================================================================
# Intentos fallidos permitidos por usuario dentro de la ventana; al agotarlos la API
# responde 429 hasta que la ventana termine. La ventana empieza con el primer
# fallo y un acierto reinicia el conteo. LOGIN_MAX_INTENTOS=0 desactiva el límite;
# vacías o inválidas usan 5 intentos / 15 minutos. Se leen en cada intento
# (tras cambiarlas, recrear `api` para que tome el .env).
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# =============================================================================
# SEEDS (solo se usan al correr el seed en el primer arranque)
# =============================================================================
# Super Administrador inicial — nunca se hardcodea un dato real de una persona
# en el código.
SEED_SUPERADMIN_DOCUMENTO=
SEED_SUPERADMIN_NOMBRE=
SEED_SUPERADMIN_SEGUNDO_NOMBRE=
SEED_SUPERADMIN_APELLIDO=
SEED_SUPERADMIN_SEGUNDO_APELLIDO=
SEED_SUPERADMIN_NUMERO_CONTACTO=''
SEED_SUPERADMIN_CORREO=
SEED_SUPERADMIN_PASSWORD=''

# Llave SSH del bastión (túnel PostgreSQL), ruta real en esta máquina. Tradicional: la API la lee
# directo. Docker: se monta en el contenedor (comandos con --env-file backend/.env).
SSH_KEY_PATH=

# CORS: * = cualquier origen; si no, URLs separadas por coma
CORS_ORIGENES=
